{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "name": "live-wallpaper-studio-api",
  "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "live-wallpaper-media-ingest" }] },
  "r2_buckets": [
    { "binding": "R2_INGEST", "bucket_name": "live-wallpaper-ingest-private" },
    { "binding": "R2_PUBLISHED", "bucket_name": "live-wallpaper-published" }
  ],
  "vars": {
    "WORKER_ENVIRONMENT": "development"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "live-wallpaper-studio-api-staging",
      "d1_databases": [{ "binding": "DB", "database_name": "live-wallpaper-studio-staging", "database_id": "5ab5270c-ac52-45c1-aaaf-7cc0b4cee355", "migrations_dir": "../database/migrations-d1" }],
      "vars": { "WORKER_ENVIRONMENT": "staging" },
      "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "live-wallpaper-media-ingest-staging" }] },
      "r2_buckets": [
        { "binding": "R2_INGEST", "bucket_name": "live-wallpaper-ingest-staging" },
        { "binding": "R2_PUBLISHED", "bucket_name": "live-wallpaper-published-staging" }
      ]
    },
    "production": {
      "name": "live-wallpaper-studio-api",
      "d1_databases": [{ "binding": "DB", "database_name": "live-wallpaper-studio", "database_id": "1bc16733-bcde-45fb-94ed-9af6f7a01bd6", "migrations_dir": "../database/migrations-d1" }],
      "vars": { "WORKER_ENVIRONMENT": "production" },
      "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "live-wallpaper-media-ingest" }] },
      "r2_buckets": [
        { "binding": "R2_INGEST", "bucket_name": "live-wallpaper-ingest-private" },
        { "binding": "R2_PUBLISHED", "bucket_name": "live-wallpaper-published" }
      ]
    }
  }
}
