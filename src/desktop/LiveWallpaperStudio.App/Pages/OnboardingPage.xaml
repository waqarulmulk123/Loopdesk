<Page
    x:Class="LiveWallpaperStudio.App.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,26" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid ColumnSpacing="40" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="18" VerticalAlignment="Center"><TextBlock Text="A NEW DESKTOP EXPERIENCE" Style="{StaticResource PageEyebrowTextBlockStyle}" /><TextBlock Text="Bring your&#x0a;desktop to life." FontSize="56" FontWeight="SemiBold" LineHeight="60" /><TextBlock Text="Discover, download and enjoy beautiful motion wallpapers. Your space, your style, your Loopdesk." FontSize="20" Foreground="{StaticResource PremiumTextSecondaryBrush}" LineHeight="32" TextWrapping="Wrap" /><TextBlock Text="✓ Browse beautiful live wallpapers&#x0a;✓ Apply downloaded videos with one click&#x0a;✓ Stay in control, even offline" LineHeight="30" TextWrapping="Wrap" /><Button Content="Get started  →" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="StartButton_Click" /></StackPanel><Border Grid.Column="1" Style="{StaticResource PageCardStyle}" CornerRadius="24" Padding="14"><Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-aurora-mountains-0-b0747490-fea4-40da-b98a-3c4202fe903d.webp" Stretch="UniformToFill" /></Border></Grid>
    </Grid>
</Page>
