<Page
    x:Class="LiveWallpaperStudio.App.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid ColumnSpacing="40" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="18" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/Loopdesk.png" Width="62" Height="62" HorizontalAlignment="Left" /><TextBlock Text="Welcome to Loopdesk" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Beautiful animated wallpapers for your Windows desktop." FontSize="18" Opacity="0.78" TextWrapping="Wrap" /><TextBlock Text="✓ Browse a real local and online collection&#x0a;✓ Download verified MP4 files for offline playback&#x0a;✓ Apply wallpaper with the native desktop renderer&#x0a;✓ Stay in control with pause and privacy settings" LineHeight="28" TextWrapping="Wrap" /><Button Content="Get started" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="StartButton_Click" /><TextBlock Text="No account is required. You can change playback and catalog settings later." Opacity="0.62" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Background="{StaticResource PremiumCardBrush}" CornerRadius="24" Padding="14"><Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-aurora-mountains-0-b0747490-fea4-40da-b98a-3c4202fe903d.webp" Stretch="UniformToFill" /></Border></Grid>
    </Grid>
</Page>
