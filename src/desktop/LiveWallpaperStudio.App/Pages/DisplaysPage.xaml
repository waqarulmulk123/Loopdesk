<Page
    x:Class="LiveWallpaperStudio.App.Pages.DisplaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="20">
            <Grid><StackPanel Spacing="4"><TextBlock Text="Displays" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Check the monitor layout detected by Windows before applying a wallpaper." Opacity="0.72" /></StackPanel><Button Content="Refresh displays" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" /></Grid>
            <Border Background="{StaticResource PremiumCardBrush}" CornerRadius="18" Padding="28"><StackPanel Spacing="20"><TextBlock Text="Monitor configuration" Style="{StaticResource SubtitleTextBlockStyle}" /><Border Background="{StaticResource PremiumSurfaceBrush}" CornerRadius="14" Padding="28" HorizontalAlignment="Stretch"><StackPanel Spacing="12" HorizontalAlignment="Center"><Border Width="360" Height="190" CornerRadius="10" BorderBrush="{StaticResource PremiumAccentBrush}" BorderThickness="3" Background="{StaticResource PremiumSurfaceBrush}"><Grid><Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-aurora-mountains-0-b0747490-fea4-40da-b98a-3c4202fe903d.webp" Stretch="UniformToFill" Opacity="0.7" /><TextBlock Text="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" FontSize="20" FontWeight="Bold" /></Grid></Border><TextBlock Text="{x:Bind ViewModel.DisplaySummary, Mode=OneWay}" TextAlignment="Center" /></StackPanel></Border><TextBlock Text="Loopdesk applies through the native renderer. Per-monitor assignment controls are shown only when the renderer reports supported display targets." TextWrapping="Wrap" Opacity="0.68" /></StackPanel></Border>
        </StackPanel>
    </Grid>
</Page>
