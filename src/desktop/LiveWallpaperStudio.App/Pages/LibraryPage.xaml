<Page
    x:Class="LiveWallpaperStudio.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,26" Background="{StaticResource ShellBackgroundBrush}" RowSpacing="20">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><StackPanel Spacing="8"><TextBlock Text="YOUR COLLECTION" Style="{StaticResource PageEyebrowTextBlockStyle}" /><TextBlock Text="My wallpapers" Style="{StaticResource PageTitleTextBlockStyle}" /><TextBlock Text="Your protected cloud downloads, ready to preview or apply." Style="{StaticResource PageSubtitleTextBlockStyle}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="Stop" Style="{StaticResource HomeSecondaryButtonStyle}" Command="{x:Bind ViewModel.StopWallpaperCommand}" /><Button Content="Preview" Style="{StaticResource HomeSecondaryButtonStyle}" Click="PreviewButton_Click" /><Button Content="Remove" Style="{StaticResource HomeSecondaryButtonStyle}" Click="RemoveButton_Click" /><Button Content="Apply selected" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplySelectedCommand}" /></StackPanel></Grid>
        <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="Search your wallpapers" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" /><Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" /></StackPanel></Grid>
        <Border Grid.Row="2" Background="{StaticResource PremiumCardBrush}" CornerRadius="18" Padding="16"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.72" TextWrapping="Wrap" /><TextBlock Text="Loopdesk only lists downloads made through Discover. Local files and drive paths are never scanned or shown." Opacity="0.62" TextWrapping="Wrap" /><ListView ItemsSource="{x:Bind ViewModel.Wallpapers, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMedia, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="12" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel><MediaPlayerElement x:Name="PreviewPlayer" Grid.Column="1" AreTransportControlsEnabled="True" AutoPlay="False" /></Grid></Border>
    </Grid>
</Page>
