<Page
    x:Class="LiveWallpaperStudio.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Local library" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Local downloads and bundled catalog MP4 files available on this PC." TextWrapping="Wrap" />
            <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="Search file names" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
                <Button Content="Refresh library" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Apply selected" Command="{x:Bind ViewModel.ApplySelectedCommand}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
            <ListView ItemsSource="{x:Bind ViewModel.LocalMedia, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedMedia, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</Page>
