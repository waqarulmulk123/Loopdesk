<Page
    x:Class="LiveWallpaperStudio.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,26" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel Spacing="8"><TextBlock Text="AVAILABLE OFFLINE" Style="{StaticResource PageEyebrowTextBlockStyle}" /><TextBlock Text="Downloads" Style="{StaticResource PageTitleTextBlockStyle}" /><TextBlock Text="Manage locally downloaded wallpaper files." Style="{StaticResource PageSubtitleTextBlockStyle}" /></StackPanel><Button Content="↻ Refresh downloads" Style="{StaticResource HomeSecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RefreshCommand}" /></Grid><Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Padding="22"><StackPanel Spacing="10"><TextBlock Text="Recent activity" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="No completed files are shown until a wallpaper has finished downloading." Opacity="0.62" /><ListView ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}" /></StackPanel></Border></Grid>
    </Grid>
</Page>
