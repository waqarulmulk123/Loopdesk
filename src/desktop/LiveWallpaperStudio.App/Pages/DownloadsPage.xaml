<Page
    x:Class="LiveWallpaperStudio.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,26" Background="{StaticResource ShellBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="AVAILABLE OFFLINE" Style="{StaticResource PageEyebrowTextBlockStyle}" /><TextBlock Text="Downloads" Style="{StaticResource PageTitleTextBlockStyle}" /><TextBlock Text="Manage protected wallpaper downloads." Style="{StaticResource PageSubtitleTextBlockStyle}" /></StackPanel><Button Grid.Column="1" Content="↻ Refresh downloads" Style="{StaticResource HomeSecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RefreshCommand}" /></Grid>
                <Border Style="{StaticResource PageCardStyle}" Padding="22"><StackPanel Spacing="10"><TextBlock Text="Recent activity" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="No completed files are shown until a wallpaper has finished downloading." Opacity="0.62" /><ListView ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}" /></StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
