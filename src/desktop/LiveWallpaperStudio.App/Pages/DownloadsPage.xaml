<Page
    x:Class="LiveWallpaperStudio.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Downloads" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Downloaded files in %LOCALAPPDATA%\LiveWallpaperStudio\downloads." TextWrapping="Wrap" />
            <Button Content="Refresh downloads" Command="{x:Bind ViewModel.RefreshCommand}" />
            <ListView ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
