<Page
    x:Class="LiveWallpaperStudio.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="12">
            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Live Wallpaper Studio — working product name, rename before release." TextWrapping="Wrap" />
            <TextBlock Text="WinUI 3 + .NET 10 + Windows App SDK 2.5.1, native C++ renderer (D3D11, Media Foundation), SQLite locally, Cloudflare Workers + D1 + R2 for the optional catalog." TextWrapping="Wrap" />
            <TextBlock Text="Offline-first. No fake content, no topmost fake wallpaper, no elevated playback." TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
