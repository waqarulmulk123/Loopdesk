<Page
    x:Class="LiveWallpaperStudio.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,26" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="22" MaxWidth="1300">
            <StackPanel Spacing="8">
                <TextBlock Text="THE APPLICATION" Style="{StaticResource PageEyebrowTextBlockStyle}" />
                <TextBlock Text="About Loopdesk" Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock Text="Native live wallpapers for Windows, designed to stay out of your way." Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>

            <Border Style="{StaticResource PageCardStyle}" Padding="40">
                <StackPanel Orientation="Horizontal" Spacing="30" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Loopdesk.png" Width="90" Height="90" />
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Loopdesk" FontSize="36" FontWeight="SemiBold" />
                        <TextBlock Text="Live Wallpapers for Windows" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                        <Border BorderBrush="#FF2F4C80" BorderThickness="1" CornerRadius="15" Padding="13,6" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Foreground="#FFAAC9FF" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PageCardStyle}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="About this app" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Loopdesk is a Windows animated-wallpaper app built with WinUI 3 and a native Direct3D 11 renderer. Browse the online catalog, download the wallpapers you choose, and apply them behind desktop icons." Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="16" LineHeight="25" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Product principles" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="✦  Native Windows experience&#x0a;◆  Respects desktop icon interaction&#x0a;◉  Protected local playback&#x0a;◇  Privacy-focused defaults" Foreground="{StaticResource PremiumTextPrimaryBrush}" FontSize="16" LineHeight="34" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
