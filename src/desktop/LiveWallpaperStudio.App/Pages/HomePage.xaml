<Page
    x:Class="LiveWallpaperStudio.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <ScrollViewer>
            <StackPanel Spacing="20">
                <Grid Height="270">
                    <Border CornerRadius="20" Background="{StaticResource PremiumSurfaceBrush}" />
                    <Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-aurora-mountains-0-b0747490-fea4-40da-b98a-3c4202fe903d.webp" Stretch="UniformToFill" Opacity="0.72" />
                    <Grid Padding="28" VerticalAlignment="Bottom">
                        <StackPanel Spacing="6" MaxWidth="540">
                            <TextBlock Text="Bring your desktop to life" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Browse the cloud collection, download a verified scene, then preview and apply it when you choose." TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.DisplaySummary, Mode=OneWay}" Opacity="0.72" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Background="{StaticResource PremiumCardBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Cloud-first library" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Loopdesk never scans, imports, or exposes files from your drives. Discover shows cloud catalog content only; My wallpapers shows only your protected Loopdesk downloads." Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
