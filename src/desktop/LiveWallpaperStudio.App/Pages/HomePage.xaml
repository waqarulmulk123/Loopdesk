<Page
    x:Class="LiveWallpaperStudio.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,32" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <ScrollViewer>
            <StackPanel Spacing="26" MaxWidth="1300">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="YOUR DESKTOP" Style="{StaticResource PageEyebrowTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" />
                        <TextBlock Text="Make your desktop a space you love." Style="{StaticResource PageSubtitleTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse wallpapers" Style="{StaticResource HomeSecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BrowseButton_Click" />
                </Grid>

                <Grid MinHeight="328">
                    <Border CornerRadius="20" Background="{StaticResource HomeHeroBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" />
                    <Image Stretch="UniformToFill" Opacity="0.78">
                        <Image.Source><BitmapImage UriSource="{x:Bind ViewModel.FeaturedPosterUri, Mode=OneWay}" DecodePixelWidth="1200" /></Image.Source>
                    </Image>
                    <Border CornerRadius="20" Background="{StaticResource HomeHeroOverlayBrush}" />
                    <StackPanel Margin="36,42,36,34" VerticalAlignment="Center" Spacing="14" MaxWidth="600">
                        <Border Background="#FF063E4A" CornerRadius="15" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock Text="FEATURED WALLPAPER" Foreground="#FF62F4E8" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}" FontSize="36" FontWeight="SemiBold" LineHeight="40" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.FeaturedDescription, Mode=OneWay}" Foreground="#FFD2DBED" FontSize="16" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="View in Discover" Style="{StaticResource HomePrimaryButtonStyle}" Click="BrowseButton_Click" />
                            <Button Content="My wallpapers" Style="{StaticResource HomeSecondaryButtonStyle}" Click="LibraryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Explore the collection" FontSize="22" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Browse Discover →" HorizontalAlignment="Right" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="12,6" Click="BrowseButton_Click" />
                </Grid>

                <GridView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                          IsItemClickEnabled="True"
                          ItemClick="CatalogItem_Click"
                          SelectionMode="None"
                          HorizontalAlignment="Left">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid ItemWidth="290" ItemHeight="262" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="274" Height="246" Style="{StaticResource PageCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="144" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{Binding PosterUri}" DecodePixelWidth="320" DecodePixelType="Logical" />
                                        </Image.Source>
                                    </Image>
                                    <Grid Grid.Row="1" Padding="16,14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#FF183B40" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Availability}" Foreground="#FF6DF7DF" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
