<Page
    x:Class="LiveWallpaperStudio.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <ScrollViewer>
            <StackPanel Spacing="16">
                <Border x:Name="AnimatedBanner" Height="96" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="Live Wallpaper Studio" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.DisplaySummary, Mode=OneWay}" />
                <TextBlock Text="Local video" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Text="{x:Bind ViewModel.VideoPath, Mode=TwoWay}" PlaceholderText="Path to an H.264 MP4 on this PC" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Preview in app" Click="PreviewButton_Click" />
                    <Button Content="Apply wallpaper" Command="{x:Bind ViewModel.ApplyCommand}" />
                    <Button Content="Stop wallpaper" Command="{x:Bind ViewModel.StopCommand}" />
                </StackPanel>
                <TextBlock Text="Preview (inside the app, before you apply it to the desktop)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <MediaPlayerElement x:Name="PreviewPlayer" Height="240" AreTransportControlsEnabled="True" AutoPlay="False" />
                <TextBlock Text="Preview plays the selected video inside this window only. Apply wallpaper hands it to the native renderer, which plays it behind desktop icons." TextWrapping="Wrap" />
                <TextBlock Text="The renderer plays the selected video behind desktop icons. If attachment is not supported on this Windows build, it stops and leaves the desktop untouched." TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
