<Page
    x:Class="LiveWallpaperStudio.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,32" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <ScrollViewer>
            <StackPanel Spacing="26" MaxWidth="1300">
                <Grid>
                    <StackPanel Spacing="8">
                        <TextBlock Text="YOUR DESKTOP" Foreground="{StaticResource PremiumAccentBrush}" FontSize="12" FontWeight="SemiBold" CharacterSpacing="170" />
                        <TextBlock Text="Good evening." FontSize="40" FontWeight="SemiBold" />
                        <TextBlock Text="Make your desktop a space you love." Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="16" />
                    </StackPanel>
                    <Button Content="+ Browse wallpapers" Style="{StaticResource HomeSecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BrowseButton_Click" />
                </Grid>

                <Grid Height="328">
                    <Border CornerRadius="20" Background="{StaticResource HomeHeroBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" />
                    <Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-aurora-mountains-0-b0747490-fea4-40da-b98a-3c4202fe903d.webp" Stretch="UniformToFill" HorizontalAlignment="Right" Width="760" Opacity="0.78" />
                    <Border CornerRadius="20" Background="{StaticResource HomeHeroOverlayBrush}" />
                    <StackPanel Margin="36,42,36,34" VerticalAlignment="Center" Spacing="14" MaxWidth="600">
                        <Border Background="#FF063E4A" CornerRadius="15" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock Text="FEATURED WALLPAPER" Foreground="#FF62F4E8" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90" />
                        </Border>
                        <TextBlock Text="Escape into&#x0a;the extraordinary." FontSize="36" FontWeight="SemiBold" LineHeight="40" />
                        <TextBlock Text="Ambient motion, breathtaking scenes, and a more personal desktop." Foreground="#FFD2DBED" FontSize="16" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Browse catalog" Style="{StaticResource HomePrimaryButtonStyle}" Click="BrowseButton_Click" />
                            <Button Content="My wallpapers" Style="{StaticResource HomeSecondaryButtonStyle}" Click="LibraryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid>
                    <TextBlock Text="Explore the collection" FontSize="22" FontWeight="SemiBold" />
                    <Button Content="Browse Discover →" HorizontalAlignment="Right" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="12,6" Click="BrowseButton_Click" />
                </Grid>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="0" Click="BrowseButton_Click">
                        <StackPanel HorizontalAlignment="Stretch" Spacing="0">
                            <Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-aurora-mountains-0-b0747490-fea4-40da-b98a-3c4202fe903d.webp" Height="144" Stretch="UniformToFill" />
                            <StackPanel Padding="16,14" Spacing="6"><TextBlock Text="Aurora Dreamscape" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Nature · Cloud" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" /><TextBlock Text="BROWSE" Foreground="{StaticResource PremiumAccentBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="0" Click="BrowseButton_Click">
                        <StackPanel HorizontalAlignment="Stretch" Spacing="0">
                            <Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-neon-cyberpunk-city-0-4ddfb59d-0306-4ffe-9660-3c4a776e127d.webp" Height="144" Stretch="UniformToFill" />
                            <StackPanel Padding="16,14" Spacing="6"><TextBlock Text="Neon city" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="City · Cloud" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" /><TextBlock Text="BROWSE" Foreground="{StaticResource PremiumAccentBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="0" Click="BrowseButton_Click">
                        <StackPanel HorizontalAlignment="Stretch" Spacing="0">
                            <Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-galaxy-nebula-0-bf04bf8b-9f6b-4e6a-aeab-ebed4775e506.webp" Height="144" Stretch="UniformToFill" />
                            <StackPanel Padding="16,14" Spacing="6"><TextBlock Text="Cosmic Infinity" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Space · Cloud" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" /><TextBlock Text="BROWSE" Foreground="{StaticResource PremiumAccentBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="0" Click="BrowseButton_Click">
                        <StackPanel HorizontalAlignment="Stretch" Spacing="0">
                            <Image Source="ms-appx:///assets/wallpapers/posters/media-generation-poster-glass-galaxy-0-2eeb06f5-8156-4f03-809c-a3c3cc065643.webp" Height="144" Stretch="UniformToFill" />
                            <StackPanel Padding="16,14" Spacing="6"><TextBlock Text="Glass Galaxy" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Abstract · Cloud" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" /><TextBlock Text="BROWSE" Foreground="{StaticResource PremiumAccentBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
