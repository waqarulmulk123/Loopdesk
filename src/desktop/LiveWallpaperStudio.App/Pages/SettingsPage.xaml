<Page
    x:Class="LiveWallpaperStudio.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <ScrollViewer>
            <StackPanel Spacing="20">
                <Grid><StackPanel Spacing="4"><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Playback, privacy, and connection preferences saved only on this PC." Opacity="0.72" /></StackPanel><Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.SaveCommand}" /></Grid>
                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PremiumCardBrush}" CornerRadius="16" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Playback &amp; performance" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch Header="Mute wallpaper audio" IsOn="{x:Bind ViewModel.Muted, Mode=TwoWay}" /><ToggleSwitch Header="Pause while fullscreen" IsOn="{x:Bind ViewModel.PauseOnFullscreen, Mode=TwoWay}" /><ToggleSwitch Header="Pause when Windows is locked" IsOn="{x:Bind ViewModel.PauseOnLock, Mode=TwoWay}" /><ToggleSwitch Header="Pause when display is off" IsOn="{x:Bind ViewModel.PauseOnDisplayOff, Mode=TwoWay}" /><ToggleSwitch Header="Pause in Battery Saver" IsOn="{x:Bind ViewModel.PauseOnBatterySaver, Mode=TwoWay}" /></StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource PremiumCardBrush}" CornerRadius="16" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Privacy &amp; connection" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch Header="Usage analytics (off by default)" IsOn="{x:Bind ViewModel.SendUsageAnalytics, Mode=TwoWay}" /><ToggleSwitch Header="Crash reports (off by default)" IsOn="{x:Bind ViewModel.SendCrashReports, Mode=TwoWay}" /><TextBox Header="Online catalog URL" Text="{x:Bind ViewModel.ApiBaseUrl, Mode=TwoWay}" PlaceholderText="Leave empty for offline-only mode" /><TextBlock Text="Leave the catalog URL blank to use Loopdesk completely offline." Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Border>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.78" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
