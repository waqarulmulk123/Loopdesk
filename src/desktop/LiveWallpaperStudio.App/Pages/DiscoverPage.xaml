<Page
    x:Class="LiveWallpaperStudio.App.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="46,34,46,26" Background="{StaticResource ShellBackgroundBrush}" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="EXPLORE" Foreground="{StaticResource PremiumAccentBrush}" FontSize="12" FontWeight="SemiBold" CharacterSpacing="170" />
                <TextBlock Text="Discover" FontSize="40" FontWeight="SemiBold" />
                <TextBlock Text="Find beautiful video wallpapers from the online catalog." Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Refresh catalog" Style="{StaticResource HomeSecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="18">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="Search titles and themes" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Search" Style="{StaticResource HomePrimaryButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="All" Style="{StaticResource HomePrimaryButtonStyle}" Padding="16,7" Command="{x:Bind ViewModel.SelectCategoryCommand}" CommandParameter="All" />
                <Button Content="Loopdesk Originals" Style="{StaticResource HomeSecondaryButtonStyle}" Padding="16,7" Command="{x:Bind ViewModel.SelectCategoryCommand}" CommandParameter="Loopdesk Originals" />
            </StackPanel>
        </StackPanel>

        <GridView Grid.Row="2"
                  Margin="0,0,0,4"
                  ItemsSource="{x:Bind ViewModel.CatalogItems, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ShowsScrollingPlaceholders="True">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="300" ItemHeight="282" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="284" Height="266" Background="{StaticResource PremiumCardBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="166" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{Binding PosterUri}" DecodePixelWidth="360" DecodePixelType="Logical" />
                                </Image.Source>
                            </Image>
                            <Grid Grid.Row="1" Padding="18,14,18,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <Border Background="#FF0D494A" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Availability}" Foreground="#FF6DF7DF" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <Border Width="42" Height="30" Background="#FF334C79" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <TextBlock Text="•••" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.Footer>
                <TextBlock Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}" Foreground="{StaticResource PremiumTextSecondaryBrush}" Margin="10,14" TextWrapping="Wrap" />
            </GridView.Footer>
        </GridView>

        <Grid Grid.Row="3" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Selected wallpaper" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.SelectedItem.Title, Mode=OneWay}" Foreground="{StaticResource PremiumTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Save favourite" Style="{StaticResource HomeSecondaryButtonStyle}" Command="{x:Bind ViewModel.ToggleFavouriteCommand}" />
                <Button Content="Download selected" Style="{StaticResource HomePrimaryButtonStyle}" Command="{x:Bind ViewModel.DownloadSelectedCommand}" />
                <Button Content="Apply selected" Style="{StaticResource HomeSecondaryButtonStyle}" Command="{x:Bind ViewModel.ApplySelectedCommand}" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
