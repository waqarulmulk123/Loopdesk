<Page
    x:Class="LiveWallpaperStudio.App.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Discover" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="Search titles and themes" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
                <Button Content="Refresh catalog" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Download selected" Command="{x:Bind ViewModel.DownloadSelectedCommand}" />
                <Button Content="Apply selected" Command="{x:Bind ViewModel.ApplySelectedCommand}" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.CatalogItems, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
