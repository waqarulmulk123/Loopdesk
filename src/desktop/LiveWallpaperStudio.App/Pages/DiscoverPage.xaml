<Page
    x:Class="LiveWallpaperStudio.App.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="20">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Discover wallpapers" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Pick a scene, download once, and apply it when you are ready." Opacity="0.72" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PremiumCardBrush}" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="Search scenes, moods, and themes" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Favourite" Command="{x:Bind ViewModel.ToggleFavouriteCommand}" />
                <Button Content="Download" Command="{x:Bind ViewModel.DownloadSelectedCommand}" />
                <Button Content="Apply" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplySelectedCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GridView ItemsSource="{x:Bind ViewModel.CatalogItems, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ShowsScrollingPlaceholders="True">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="250" ItemHeight="220" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="238" Height="208" Background="{StaticResource PremiumCardBrush}" CornerRadius="16" Padding="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="132" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border CornerRadius="11" Background="{StaticResource PremiumSurfaceBrush}">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{Binding PosterUri}" DecodePixelWidth="300" DecodePixelType="Logical" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Opacity="0.68" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border Grid.Column="1" Background="{StaticResource PremiumCardBrush}" CornerRadius="20" Padding="14" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="Selected wallpaper" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Height="190" CornerRadius="12" Background="{StaticResource PremiumSurfaceBrush}">
                        <Image Source="{x:Bind ViewModel.SelectedItem.PosterUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.Subtitle, Mode=OneWay}" Opacity="0.72" TextWrapping="Wrap" />
                    <Button Content="Save favourite" Command="{x:Bind ViewModel.ToggleFavouriteCommand}" />
                    <TextBlock Text="Download keeps a verified local copy. Apply only changes the desktop after it is ready." Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
