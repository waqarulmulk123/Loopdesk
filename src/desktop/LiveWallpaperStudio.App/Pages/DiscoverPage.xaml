<Page
    x:Class="LiveWallpaperStudio.App.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Discover" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="Search titles and themes" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
                <Button Content="Refresh catalog" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.CatalogItems, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
