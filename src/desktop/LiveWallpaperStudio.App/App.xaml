<Application
    x:Class="LiveWallpaperStudio.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Premium design system (see docs/UI_UX.md). Dark, calm,
                 high-contrast, generous spacing. Accent is used sparingly:
                 primary actions only, never as a background wash. -->
            <Color x:Key="PremiumAccentColor">#FF7C5CFF</Color>
            <Color x:Key="PremiumAccentLightColor">#FF9D8CFF</Color>
            <Color x:Key="PremiumGoldColor">#FFFFC94D</Color>
            <Color x:Key="PremiumCardColor">#FF1E1E24</Color>
            <Color x:Key="PremiumTextPrimaryColor">#FFFFFFFF</Color>
            <Color x:Key="PremiumTextSecondaryColor">#FFB8B8C0</Color>
            <SolidColorBrush x:Key="PremiumAccentBrush" Color="{StaticResource PremiumAccentColor}" />
            <SolidColorBrush x:Key="PremiumGoldBrush" Color="{StaticResource PremiumGoldColor}" />
            <SolidColorBrush x:Key="PremiumCardBrush" Color="{StaticResource PremiumCardColor}" />
            <SolidColorBrush x:Key="PremiumTextSecondaryBrush" Color="{StaticResource PremiumTextSecondaryColor}" />
            <CornerRadius x:Key="PremiumCardCornerRadius">12,12,12,12</CornerRadius>
            <CornerRadius x:Key="PremiumButtonCornerRadius">8,8,8,8</CornerRadius>
            <Thickness x:Key="PremiumPagePadding">24,24,24,24</Thickness>
            <x:Double x:Key="PremiumTitleFontSize">28</x:Double>
            <x:Double x:Key="PremiumSubtitleFontSize">18</x:Double>
            <x:Double x:Key="PremiumBodyFontSize">14</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
