<Application
    x:Class="LiveWallpaperStudio.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Shared tokens are intentionally close to the approved 1600×1000 prototype. -->
            <Color x:Key="PremiumAccentColor">#FF50DDF1</Color>
            <Color x:Key="PremiumAccentLightColor">#FFB9F7FF</Color>
            <Color x:Key="PremiumGoldColor">#FFFFD166</Color>
            <Color x:Key="PremiumCardColor">#FF101A30</Color>
            <Color x:Key="PremiumSurfaceColor">#FF080E20</Color>
            <Color x:Key="PremiumTextPrimaryColor">#FFF1F6FF</Color>
            <Color x:Key="PremiumTextSecondaryColor">#FF9DADC9</Color>
            <SolidColorBrush x:Key="PremiumAccentBrush" Color="{StaticResource PremiumAccentColor}" />
            <SolidColorBrush x:Key="PremiumGoldBrush" Color="{StaticResource PremiumGoldColor}" />
            <SolidColorBrush x:Key="PremiumCardBrush" Color="{StaticResource PremiumCardColor}" />
            <SolidColorBrush x:Key="PremiumSurfaceBrush" Color="{StaticResource PremiumSurfaceColor}" />
            <SolidColorBrush x:Key="PremiumTextPrimaryBrush" Color="{StaticResource PremiumTextPrimaryColor}" />
            <SolidColorBrush x:Key="PremiumTextSecondaryBrush" Color="{StaticResource PremiumTextSecondaryColor}" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF080E20" />
            <SolidColorBrush x:Key="ShellRailBrush" Color="#FF0F1630" />
            <SolidColorBrush x:Key="ShellBorderBrush" Color="#FF20273D" />
            <SolidColorBrush x:Key="HomeHeroBrush" Color="#FF0B1C38" />
            <LinearGradientBrush x:Key="HomeHeroOverlayBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF08182E" Offset="0" />
                <GradientStop Color="#EC08182E" Offset="0.37" />
                <GradientStop Color="#3508182E" Offset="0.76" />
                <GradientStop Color="#0008182E" Offset="1" />
            </LinearGradientBrush>
            <CornerRadius x:Key="PremiumCardCornerRadius">12,12,12,12</CornerRadius>
            <CornerRadius x:Key="PremiumButtonCornerRadius">8,8,8,8</CornerRadius>
            <Thickness x:Key="PremiumPagePadding">24,24,24,24</Thickness>
            <x:Double x:Key="PremiumTitleFontSize">28</x:Double>
            <x:Double x:Key="PremiumSubtitleFontSize">18</x:Double>
            <x:Double x:Key="PremiumBodyFontSize">14</x:Double>
            <Style x:Key="HomePrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF1769E8" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#FF4397FF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="HomeSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF101D38" />
                <Setter Property="Foreground" Value="#FFF3F6FF" />
                <Setter Property="BorderBrush" Value="#FF2B4169" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource HomePrimaryButtonStyle}" />
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PremiumTextPrimaryBrush}" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PremiumTextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageEyebrowTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PremiumAccentBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="170" />
            </Style>
            <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
            <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PremiumTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="PageCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PremiumCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
