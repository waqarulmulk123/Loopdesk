<Window
    x:Class="LiveWallpaperStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Loopdesk">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="NavView"
                    Background="{StaticResource ShellBackgroundBrush}"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    PaneDisplayMode="Left"
                    CompactPaneLength="64"
                    OpenPaneLength="196"
                    SelectionChanged="NavView_SelectionChanged"
                    Loaded="NavView_Loaded">
        <NavigationView.Header>
            <Grid Height="64" Padding="28,0,28,0" Background="{StaticResource ShellBackgroundBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Loopdesk" Foreground="{StaticResource PremiumTextSecondaryBrush}" />
                    <TextBlock Text="/" Foreground="#FF50617F" />
                    <TextBlock x:Name="BreadcrumbPage" Text="Home" Foreground="{StaticResource PremiumTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#FF10223A" BorderBrush="#FF184863" BorderThickness="1" CornerRadius="16" Padding="14,6">
                        <TextBlock Text="DESIGN CONCEPT" Foreground="{StaticResource PremiumAccentBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                    </Border>
                    <Border Background="#FF101C36" BorderBrush="#FF2A4169" BorderThickness="1" CornerRadius="16" Padding="14,6">
                        <TextBlock Text="Windows desktop" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" />
                    </Border>
                    <Border Width="34" Height="34" CornerRadius="17" Background="#FF4E86F7">
                        <TextBlock Text="L" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </NavigationView.Header>
        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="14,14,0,18">
                <Image Source="ms-appx:///Assets/Loopdesk.png" Width="36" Height="36" />
                <TextBlock Text="Loopdesk" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="YOUR WORKSPACE" />
            <NavigationViewItem Content="Onboarding" Tag="Onboarding" Icon="Play" />
            <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
            <NavigationViewItem Content="Library" Tag="Library" Icon="Folder" />
            <NavigationViewItem Content="Discover" Tag="Discover" Icon="Globe" />
            <NavigationViewItem Content="Favourites" Tag="Favourites" Icon="Favorite" />
            <NavigationViewItem Content="Downloads" Tag="Downloads" Icon="Download" />
            <NavigationViewItem Content="Displays" Tag="Displays" Icon="View" />
            <NavigationViewItemHeader Content="SYSTEM" />
            <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            <NavigationViewItem Content="Diagnostics" Tag="Diagnostics" Icon="Document" />
            <NavigationViewItem Content="About" Tag="About" Icon="Help" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel Padding="14,8,14,16" Spacing="8">
                <Border Height="1" Background="{StaticResource ShellBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="#FF3BEAA0" VerticalAlignment="Center" />
                    <TextBlock Text="Renderer service • Ready" Foreground="{StaticResource PremiumTextSecondaryBrush}" FontSize="12" />
                </StackPanel>
                <TextBlock Text="UI CONCEPT • NOT A LIVE SCREENSHOT" Foreground="#FF7789AA" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </NavigationView.PaneFooter>
        <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
    </NavigationView>
</Window>
