<Window
    x:Class="LiveWallpaperStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Live Wallpaper Studio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="NavView" IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged" Loaded="NavView_Loaded">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
            <NavigationViewItem Content="Library" Tag="Library" Icon="Folder" />
            <NavigationViewItem Content="Discover" Tag="Discover" Icon="Globe" />
            <NavigationViewItem Content="Favourites" Tag="Favourites" Icon="Favorite" />
            <NavigationViewItem Content="Downloads" Tag="Downloads" Icon="Download" />
            <NavigationViewItem Content="Displays" Tag="Displays" Icon="View" />
            <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            <NavigationViewItem Content="Diagnostics" Tag="Diagnostics" Icon="Document" />
            <NavigationViewItem Content="About" Tag="About" Icon="Help" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
